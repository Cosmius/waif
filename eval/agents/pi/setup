#!/usr/bin/env python3
"""Makes AGENT_HOME a ready-to-use home for pi.

    setup AGENT_HOME PROVIDER/MODEL/EFFORT WAIF_SOURCE

Prints, as JSON, the hosts pi needs and the variables to pass it, such
as ANTHROPIC_API_KEY.
"""
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

PROVIDERS = {
    "anthropic": {
        "pi": "anthropic",
        "host": "api.anthropic.com",
        "key_env": "ANTHROPIC_API_KEY",
        "models": {
            "fable-5.2": "claude-fable-5-2",
            "opus-5.5": "claude-opus-5-5",
            "sonnet-5.5": "claude-sonnet-5-5",
            "haiku-5.5": "claude-haiku-5-5",
        },
    },
}
PACKAGE_TREES = ("skills", "protocol", "migration")


def stop(message):
    sys.exit(f"pi setup: {message}")


def split_model(text):
    provider, model, effort = text.split("/")
    if provider not in PROVIDERS:
        stop(f"no pi provider for {provider!r}")
    if model not in PROVIDERS[provider]["models"]:
        stop(f"no pi model for {provider}/{model}")
    return provider, model, effort


def configure(home, provider, model, effort):
    """pi's model and system prompt."""
    agent_dir = home / "pi-agent"
    settings = {
        "defaultProvider": PROVIDERS[provider]["pi"],
        "defaultModel": PROVIDERS[provider]["models"][model],
        "defaultThinkingLevel": effort,
        "theme": "light",
        "enableInstallTelemetry": False,
        "enableAnalytics": False,
    }
    (agent_dir / "settings.json").write_text(json.dumps(settings))
    shutil.copy(Path(__file__).parent / "system-prompt.md", agent_dir / "SYSTEM.md")


def install_waif(home, source):
    cargo = ["cargo", "build", "--quiet", "--manifest-path", source / "Cargo.toml"]
    build = subprocess.run(cargo, capture_output=True, text=True)
    if build.returncode != 0:
        stop(f"cargo build failed:\n{build.stderr}")
    waif = source / "target" / "debug" / "waif"
    with tempfile.TemporaryDirectory() as build_dir:
        package = ["waif", "package", "--target", "pi-package"]
        subprocess.run(package, executable=waif, cwd=build_dir,
                       stdout=subprocess.DEVNULL, check=True)
        built = Path(build_dir) / "dist" / "pi-package"
        for tree in PACKAGE_TREES:
            shutil.copytree(built / tree, home / "pi-agent" / tree)
    (home / "bin").mkdir()
    shutil.copy(waif, home / "bin" / "waif")


def main():
    home, source = Path(sys.argv[1]), Path(sys.argv[3])
    provider, model, effort = split_model(sys.argv[2])
    install_waif(home, source)
    configure(home, provider, model, effort)
    needs = {"hosts": [PROVIDERS[provider]["host"]], "env": [PROVIDERS[provider]["key_env"]]}
    print(json.dumps(needs))


if __name__ == "__main__":
    main()
